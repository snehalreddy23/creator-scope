# ==========================================
# CreatorScope Environment Variables Template
# ==========================================
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT REAL API KEYS TO SOURCE CONTROL.

# --- Data Provider Configuration ---
# Choose 'mock' (default, free offline sample dataset) or 'gramscraper' (live API)
INSTAGRAM_PROVIDER=mock

# GramScraper API credentials (required only when INSTAGRAM_PROVIDER=gramscraper)
# Obtain an API key from https://gramscraper.com
GRAMSCRAPER_API_KEY=gs_your_api_key_here
GRAMSCRAPER_BASE_URL=https://gramscraper.com/api/instagram/v1

# --- Performance & Caching ---
# In-memory cache TTL in seconds (900s = 15 minutes)
CACHE_TTL_SECONDS=900

# Upstream HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=12.0

# Rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=30

# --- Frontend & CORS Configuration ---
# API base URL for frontend requests (local dev or production backend host)
VITE_API_BASE_URL=http://localhost:8000/api

# Allowed CORS origins for FastAPI (comma-separated in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://creatorscope.vercel.app

# --- Persistence (Optional) ---
# Default persistence uses built-in SQLite (creatorscope.db)
# If connecting external PostgreSQL / Supabase, configure below:
# DATABASE_URL=postgresql://user:password@localhost:5432/creatorscope
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
